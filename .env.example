# API Keys - 複製此檔案為 .env 並填入你的金鑰
# cp .env.example .env

# Gemini API 金鑰（使用 --provider gemini 時需要，為預設提供商）
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API 金鑰（使用 --provider openai 時需要）
OPENAI_API_KEY=your_openai_api_key_here

# 自訂 OpenAI-compatible endpoint（只用於 --provider openai）
# OPENAI_BASE_URL=http://127.0.0.1:8787/v1
# --provider local-runtime 直接讀取 runtime 的 connection.json，不使用此處金鑰
